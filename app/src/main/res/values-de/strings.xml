  <string name="privacy_policy"><![CDATA[<b>Datenschutzerklärung:</b><br/>Suntimes erfasst, speichert oder übermittelt keine persönlichen Benutzerdaten. Die App enthält <b>keine Werbung</b>, <b>keine Analytik</b>, <b>keine Tracker</b> und verlangt <b>keine unnötigen Berechtigungen</b>. <br/><br/>Die App wird über Ortsinformationen konfiguriert. Diese Informationen (und andere von der App verwendete Konfigurationsdaten) werden lokal gespeichert und verlassen das Gerät nicht.<br/><br/><xliff:g id="permissionsExplained">%1$s</xliff:g>]]></string> <!-- Don't nail me on legal texts.-->
  <string name="privacy_permission_calendar"><![CDATA[Suntimes verwendet <b>Kalenderberechtigungen</b> zur Integration in die Kalender-App. Diese Berechtigungen erlauben der App eigene Kalender und Ereignisse zu erzeugen.<br/><br/>Berechtigungen werden auch benötigt um die Kalenderintegration zu deaktivieren und um eigene Kalendar zu löschen.]]></string> 
  <string name="privacy_permissiondialog_title">Berechtigungen</string> 

