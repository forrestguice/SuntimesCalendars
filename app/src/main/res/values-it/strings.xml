    <string name="help_flags"><![CDATA[
        <h3>Flag</h3>
        Queste impostazioni vengono applicate quando si aggiungono gli eventi del calendario.
        <br/><br/>
        Per modificare gli eventi di un calendario, cambia queste impostazioni, poi rimuovi e aggiungi nuovamente il calendario.
    ]]></string>
    <string name="help_template"><![CDATA[
        <h3>Modelli</h3>
        I modelli vengono applicati quando si aggiungono gli eventi del calendario.
        <br/><br/>
        Per modificare la formattazione degli eventi di un calendario, modifica il suo modello, poi rimuovi e aggiungi nuovamente il calendario.
        <br/><br/>
        <h3>Sostituzioni</h3>
        %s
    ]]></string>
